# ── ASSIMILATE environment variables ─────────────────────────────────────────
# Copy to `.env.local` for local development. NEVER commit real values.
# Full reference: docs/DEPLOYMENT.md §Environment variables.

# ── Client (build-time, PUBLIC — anything VITE_* ships to every visitor) ─────

# Payment provider the client uses. 'sandbox' = the offline dev stub (grants flow,
# no money moves, receipts say sandbox). 'stripe' = real Stripe Checkout via /api.
VITE_CHECKOUT_PROVIDER=sandbox

# Cloudflare Turnstile SITE key (public). Empty = Turnstile disabled (dev).
VITE_TURNSTILE_SITE_KEY=

# Rewarded-ad provider for the Field Research lane (docs/RESEARCH.md).
# 'none' hides the lane entirely (launch default until an ad network is chosen);
# 'simulated' shows a themed dev stub so the reward loop can be tested end-to-end;
# 'google' uses Google H5 Games Ads — ALSO run `npm run set-ads -- google --client …`
# (CSP + ads.txt) and set the client id below.
VITE_ADS_PROVIDER=none

# AdSense publisher id (ca-pub-…) for VITE_ADS_PROVIDER=google. Public, not a secret.
VITE_ADS_GOOGLE_CLIENT=

# ── Server (Cloudflare Pages project → Settings → Environment variables) ─────
# These are SECRETS for Pages Functions only. They are never bundled into the
# client and must never be prefixed VITE_.

# Stripe secret API key (sk_test_… in preview, sk_live_… in production).
STRIPE_SECRET_KEY=

# Stripe webhook signing secret for the /api/stripe/webhook endpoint (whsec_…).
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile SECRET key. Empty = server skips verification (dev only).
TURNSTILE_SECRET_KEY=

# Random 32+ byte hex secret for daily-run day tickets (leaderboard day binding).
# Generate once:  openssl rand -hex 32
DAY_TICKET_SECRET=

# Password-reset email delivery webhook (docs/ACCOUNTS.md) — any provider accepting
# POST {to, token}. Leave unset to disable reset emails (endpoint answers 503).
RESET_EMAIL_WEBHOOK=

# 'production' | 'preview' — set automatically per Pages environment; used to
# refuse test-mode Stripe keys in production.
ENVIRONMENT=preview

# Auction House moderation key (docs/AUCTION-HOUSE.md §6) — gates /api/auction/flags.
# Absent = moderation lane closed (503). Server-side only (wrangler pages secret put MOD_KEY).
# MOD_KEY=
