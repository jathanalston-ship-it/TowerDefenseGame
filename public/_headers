# Cloudflare Pages headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Vite emits content-hashed files under /assets, so they are safe to cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Sensible defaults for all responses. index.html keeps Pages' default (short)
# cache so new deploys are picked up immediately — do not long-cache it here.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
