# Public build-time configuration (COMMITTED — no secrets here, ever).
# Vite folds VITE_* values into the client bundle at build time; editing this file
# and pushing is the no-dashboard way to configure the public half of the game.
# A variable of the same name set in Cloudflare Pages → Environment variables
# overrides the value here. Server SECRETS are set with `npm run setup-secrets`.

# Checkout: 'sandbox' (default; free dev store, no charges) or 'stripe' once
# STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET are set (RELEASE-GUIDE steps 9–10).
VITE_CHECKOUT_PROVIDER=stripe

# Turnstile bot protection — the PUBLIC site key (pair of TURNSTILE_SECRET_KEY).
# From Cloudflare → Turnstile → your site (RELEASE-GUIDE step 7). Empty = disabled.
VITE_TURNSTILE_SITE_KEY=

# Rewarded ads (Field Research) — 'none' | 'simulated' | 'google'.
# 'google' additionally needs VITE_ADS_GOOGLE_CLIENT and `npm run set-ads -- google …`
# (CSP + ads.txt), and an approved AdSense account (RELEASE-GUIDE step 19).
VITE_ADS_PROVIDER=none
VITE_ADS_GOOGLE_CLIENT=
