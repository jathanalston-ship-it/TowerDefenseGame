{
  "name": "assimilate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ASSIMILATE — a cyberpunk bio-horror tower defense (playable vertical slice). Static React + TypeScript + Vite app, built for Cloudflare Pages.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "docs:graph": "vite-node scripts/gen-depgraph.ts",
    "docs:check": "vite-node scripts/doc-sync.ts",
    "validate": "vite-node scripts/validate.ts",
    "handoff": "vite-node scripts/handoff.ts",
    "sim:progression": "vite-node scripts/sim-progression.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright-core": "^1.47.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
